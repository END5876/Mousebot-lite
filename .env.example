# ── 必填 ─────────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=

# 擁有者 Discord 使用者 ID（可用逗號分隔多個）。
# 未設定時沒有人能透過 /autojoin 變更目標頻道（fail-closed）。
OWNER_USER_ID=

# ── autojoin ─────────────────────────────────────────────
# 只在第一次啟動、還沒有 data/autojoin.json 時當作初始目標頻道；之後以 /autojoin 設定為準。
TARGET_VOICE_CHANNEL_ID=

# ── 音樂（全部選填）─────────────────────────────────────
# 本地快取上限（MB），超過時刪除最舊的檔案
# MAX_CACHE_SIZE_MB=2048

# Bilibili 登入 Cookie（提升可播放範圍與穩定度）
# BILIBILI_SESSDATA=
# BILIBILI_BILI_JCT=
# BILIBILI_DEDEUSERID=

# YouTube：優先使用 data/www.youtube.com_cookies.txt 或 data/cookies.txt；
# 沒有 cookies 檔時才讀下面兩個值
# YOUTUBE_SESSION_ID=
# YOUTUBE_VISITOR_INFO=

# 手動指定 PO Token（Docker 內建 bgutil 會自動產生，通常不需要）
# YOUTUBE_PO_TOKEN=
# bgutil 伺服器不在同一個容器時才需要設定（預設 http://127.0.0.1:4416）
# YT_POT_PROVIDER_URL=

# YouTube 請求改走 Proxy（例如 Cloudflare WARP）
# WARP_PROXY_URL=

# 多台 Bot 共用音樂庫服務（未設定時使用本地 data/music）
# MUSIC_LIB_URL=
# MUSIC_LIB_SECRET=

# 網頁「Bot 正在播放」同步（有設 MUSIC_LIB_URL 時自動啟用；0 = 關閉）
# WEB_SYNC=1
# WEB_SYNC_BOT_NAME=              # 網頁上顯示的名稱（預設 Bot 使用者名稱）
# WEB_SYNC_BOT_ID=                # 網頁上識別這台 Bot 的 ID（預設 Discord 應用程式 ID）
# WEB_SYNC_ANNOUNCE=1             # 網頁操作時在點歌頻道留一行紀錄（0 = 不留）

# 重啟後自動接續播放（0 = 停用）；快照超過幾分鐘就不接續
# MUSIC_RESUME=1
# MUSIC_RESUME_MAX_AGE_MIN=15

# ── AI 聊天（選用，單一人格）────────────────────────────
# 填了才啟用 /ai、@ 提及回覆與隨機插話；留空＝完全不啟用（不載入模組、不需要 Message Content Intent）。
# 啟用時必須在 Discord Developer Portal → Bot 開啟 Message Content Intent，否則無法登入。
GEMINI_API_KEY=
# 人格代號（預設 bigfish）：讀 data/prompts/modes/<代號>.md（不跟程式碼一起部署，要自己放進 data/）；
# 找不到檔案時用內建的通用人格
# AI_PERSONA=bigfish
# 同群有多隻 bot 時的隨機回覆區段 i/n（第 i 隻、共 n 隻，從 0 起），避免同一句話好幾隻都回；預設 1/2（MouseBot 預設 0/2），單獨一隻不用設
# AI_RANDOM_SLOT=1/2
# 模型（預設 gemini-3.1-flash-lite）
# GEMINI_MODEL=
# 啟用 Google 搜尋接地的伺服器 ID（逗號分隔）；未設定則停用
# GEMINI_SEARCH_GUILD_IDS=
# 群組歷史保留的則數（30 分鐘內），預設 24；調小可省 token
# AI_GROUP_MSG_LIMIT=24
# 用量限制（0 = 不限制）：每人頻率、每人每日 token、全體每日 token（擁有者也受全體上限約束）
# AI_USER_RATE_LIMIT=8
# AI_USER_RATE_WINDOW_SEC=60
# AI_USER_DAILY_TOKEN_BUDGET=0
# AI_DAILY_TOKEN_BUDGET=0
# 表情包（data/memes/<人格>/，見 README「表情包」）：送出前縮到長邊幾 px（預設 160，0 = 不縮）
# MEME_DISPLAY_SIZE=160
# 表情包公開網址（https）：設了就改送「只有圖片網址」的訊息，手機版不會把圖拉滿寬度；
# 要有反向代理把 <網址>/<人格>/small-<px>/<檔名> 對到 data/memes/<人格>/.cache/small-<px>/<檔名>。沒設＝送附件
# MEME_PUBLIC_URL=https://meme.example.com
# 全體每日 token 用完時通知的 Discord webhook（未設定＝不通知）
# ALERT_WEBHOOK_URL=
# ALERT_NAME=mousebot-lite

# ── 管理 API（選用；給 admin-panel 服務呼叫）───────────────
# 填了才啟動：在 admin-panel 的網頁上就能看狀態、點歌、設定自動加入、改 Bot 狀態、看日誌。
# 至少 32 個字元，要和 admin-panel 的 PANEL_TOKEN_<代號> 相同；不要讓這個 port 直接對外公開。
# 產生：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ADMIN_AGENT_TOKEN=
# ADMIN_PORT=3940
# ADMIN_HOST=127.0.0.1            # Docker 裡讓 admin-panel 連進來時設 0.0.0.0
# RESTART_MANAGED=1               # 程序結束後會被自動重新啟動（容器 restart: unless-stopped）；面板的「重新啟動」按鈕據此顯示

# ── 執行環境 ─────────────────────────────────────────────
# Log 等級：debug | info（預設）| warn | error（DEBUG_STARTUP=true 等同 debug）
# LOG_LEVEL=info
# 設定後 Slash Commands 只註冊到這個伺服器（開發用，立即生效）
# DEV_GUILD_ID=
# 1 = 忽略指令 hash 比對，強制重新註冊
# FORCE_COMMAND_SYNC=0
# /healthz 健康檢查埠（0 = 停用）；Docker HEALTHCHECK 使用
# HEALTH_PORT=3939

# ── 除錯 ─────────────────────────────────────────────────
# 設為 0：發生 uncaughtException 時只記錄、不結束程序（本機沒有自動重啟機制時可用）
# EXIT_ON_UNCAUGHT=0
